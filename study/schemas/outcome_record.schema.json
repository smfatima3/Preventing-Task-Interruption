{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HRS measured outcome record",
  "type": "object",
  "required": [
    "schema_version",
    "data_kind",
    "stage_id",
    "run_id",
    "scenario_id",
    "task",
    "stratum",
    "split",
    "method",
    "training_seed",
    "variant",
    "replicate",
    "added_delay_ms",
    "physics_variant",
    "status",
    "sensor_input_source",
    "simulator_time_advanced_during_compute",
    "observation_time_s",
    "decision_time_s",
    "action_start_time_s",
    "observed_duration_s",
    "stable_followup_s",
    "raw_trace_path",
    "measurements",
    "policy_sha256",
    "scenario_sha256",
    "snapshot_sha256",
    "human_trajectory_sha256",
    "config_sha256",
    "raw_trace_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "data_kind": {
      "enum": [
        "measured_simulation",
        "measured_hardware"
      ]
    },
    "stage_id": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6",
        "E7",
        "E8",
        "E9",
        "E10",
        "E11",
        "E12",
        "E13",
        "E14"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "stratum": {
      "enum": [
        "benign",
        "avoidable",
        "severe"
      ]
    },
    "split": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "training_seed": {
      "type": "integer",
      "minimum": 0
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "replicate": {
      "type": "integer",
      "minimum": 0
    },
    "added_delay_ms": {
      "type": "number",
      "minimum": 0
    },
    "physics_variant": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "complete",
        "timeout",
        "controller_failure",
        "infrastructure_failure"
      ]
    },
    "sensor_input_source": {
      "const": "estimated"
    },
    "simulator_time_advanced_during_compute": {
      "const": true
    },
    "observation_time_s": {
      "type": "number",
      "minimum": 0
    },
    "decision_time_s": {
      "type": "number",
      "minimum": 0
    },
    "action_start_time_s": {
      "type": "number",
      "minimum": 0
    },
    "observed_duration_s": {
      "type": "number",
      "minimum": 0
    },
    "stable_followup_s": {
      "type": "number",
      "minimum": 0
    },
    "raw_trace_path": {
      "type": "string",
      "minLength": 1
    },
    "measurements": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "robot_human_contact": {
          "type": "boolean"
        },
        "object_human_contact": {
          "type": "boolean"
        },
        "object_drop": {
          "type": "boolean"
        },
        "robot_fall": {
          "type": "boolean"
        },
        "limit_violation": {
          "type": "boolean"
        },
        "task_success": {
          "type": "boolean"
        },
        "aborted": {
          "type": "boolean"
        },
        "unresolved": {
          "type": "boolean"
        },
        "max_contact_impulse_ns": {
          "type": "number",
          "minimum": 0
        },
        "peak_contact_force_n": {
          "type": "number",
          "minimum": 0
        },
        "max_object_impact_energy_j": {
          "type": "number",
          "minimum": 0
        },
        "interventions": {
          "type": "integer",
          "minimum": 0
        },
        "switches": {
          "type": "integer",
          "minimum": 0
        },
        "deadline_misses": {
          "type": "integer",
          "minimum": 0
        },
        "latencies_ms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "human_trajectory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_trace_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "measurements": {
            "type": "object",
            "required": [
              "robot_human_contact",
              "object_human_contact",
              "object_drop",
              "robot_fall",
              "limit_violation",
              "task_success",
              "aborted",
              "unresolved",
              "max_contact_impulse_ns",
              "peak_contact_force_n",
              "max_object_impact_energy_j",
              "interventions",
              "switches",
              "deadline_misses",
              "latencies_ms"
            ],
            "properties": {
              "robot_human_contact": {
                "type": "boolean"
              },
              "object_human_contact": {
                "type": "boolean"
              },
              "object_drop": {
                "type": "boolean"
              },
              "robot_fall": {
                "type": "boolean"
              },
              "limit_violation": {
                "type": "boolean"
              },
              "task_success": {
                "type": "boolean"
              },
              "aborted": {
                "type": "boolean"
              },
              "unresolved": {
                "type": "boolean"
              },
              "max_contact_impulse_ns": {
                "type": "number",
                "minimum": 0
              },
              "peak_contact_force_n": {
                "type": "number",
                "minimum": 0
              },
              "max_object_impact_energy_j": {
                "type": "number",
                "minimum": 0
              },
              "interventions": {
                "type": "integer",
                "minimum": 0
              },
              "switches": {
                "type": "integer",
                "minimum": 0
              },
              "deadline_misses": {
                "type": "integer",
                "minimum": 0
              },
              "latencies_ms": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "failure_reason"
        ],
        "properties": {
          "failure_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$comment": "Python validator additionally checks finite values, hashes, paths, pairing, time order, exposure and locks. Field labels cannot prove measurement authenticity."
}
